# FitCoach environment template.
# Copy to `.env` at the repository root:
#
#   cp .env.example .env
#
# The root `.env` is read by:
#   * the root npm scripts (`db:*`, `api:start`, `test`) via --env-file-if-exists;
#   * `apps/api` (`npm start -w @fitcoach/api`) via --env-file-if-exists=../.env;
#   * the Prisma CLI when run from the repository root (the `db:*` scripts);
#   * `node --env-file=.env <script>` for ad-hoc commands.
#
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string.
# Used by Prisma CLI commands (migrations), the seed, and the API at runtime.
#
# `npm run dev` and `npm run dev:api` fall back to an embedded PostgreSQL
# cluster in `.devstack/pg` when this is unset or nothing is listening on it,
# so local UI work does not need a system PostgreSQL install.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fitcoach?schema=public"

# ---------------------------------------------------------------------------
# Optional: Pooled connection string for runtime (PgBouncer transaction pooling).
# When set, the API uses this for application queries; DATABASE_URL is used
# for migrations and direct administrative operations.
# ---------------------------------------------------------------------------
# DATABASE_URL_POOLED="postgresql://postgres:postgres@127.0.0.1:6543/fitcoach?schema=public&pgbouncer=true"

# ---------------------------------------------------------------------------
# Optional: API port. Defaults to 8787 when unset.
# ---------------------------------------------------------------------------
# PORT=8787

# ---------------------------------------------------------------------------
# Optional: external disposable database for integration and smoke tests.
# When set, tests apply prisma/migrations to it — it MUST be wipeable, UTF-8
# encoded, and reachable without elevation. When unset, tests boot an
# embedded PostgreSQL cluster in a temp directory instead.
# ---------------------------------------------------------------------------
# FITCOACH_TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/fitcoach_test?schema=public"

# ---------------------------------------------------------------------------
# Supabase Configuration (Phase 9.5)
# ---------------------------------------------------------------------------
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
#
# The anon key is safe for browser bundles; the service role key MUST NOT
# appear in any frontend code or client-side bundle.

# ---------------------------------------------------------------------------
# AI Provider Configuration (Phase 9.5)
# ---------------------------------------------------------------------------
# AI_PROVIDER="mock" | "anthropic" | "openai"
# AI_PROVIDER=mock
#
# ANTHROPIC_API_KEY="sk-ant-..."
# OPENAI_API_KEY="sk-..."
#
# Mock provider is the only one that works without an API key. Real providers
# fail fast with a clear error if their key is missing.