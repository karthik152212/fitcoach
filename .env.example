# FitCoach environment template.
# Copy to `.env` at the repository root:
#
#   cp .env.example .env
#
# The root `.env` is read by:
#   * the root npm scripts (`db:*`, `api:start`, `test`) via --env-file-if-exists;
#   * `apps/api` (`npm start -w @fitcoach/api`) via --env-file-if-exists=../.env;
#   * the Prisma CLI when run from the repository root (the `db:*` scripts);
#   * `node --env-file=.env <script>` for ad-hoc commands.
#
# `.env` is gitignored — never commit real credentials.

# ---------------------------------------------------------------------------
# Required: PostgreSQL connection string.
# Used by Prisma CLI commands (migrations), the seed, and the API at runtime.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/fitcoach?schema=public"

# ---------------------------------------------------------------------------
# Optional: API port. Defaults to 8787 when unset.
# ---------------------------------------------------------------------------
# PORT=8787

# ---------------------------------------------------------------------------
# Optional: external disposable database for integration and smoke tests.
# When set, tests apply prisma/migrations to it — it MUST be wipeable, UTF-8
# encoded, and reachable without elevation. When unset, tests boot an
# embedded PostgreSQL cluster in a temp directory instead.
# ---------------------------------------------------------------------------
# FITCOACH_TEST_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/fitcoach_test?schema=public"
