{
  "name": "fitcoach",
  "version": "0.0.0",
  "private": true,
  "description": "Adaptive personal fitness coaching platform.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.9"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -b tsconfig.build.json",
    "test": "npm run build && node --env-file-if-exists=.env --test \"**/dist/**/*.test.js\"",
    "lint": "echo \"lint: placeholder (no linter configured yet)\"",
    "db:generate": "prisma generate --schema packages/db/prisma/schema.prisma",
    "db:validate": "prisma validate --schema packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema packages/db/prisma/schema.prisma",
    "db:seed": "npm run build && node --env-file-if-exists=.env packages/db/dist/seed/cli.js",
    "api:start": "npm run build && node --env-file-if-exists=.env apps/api/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
