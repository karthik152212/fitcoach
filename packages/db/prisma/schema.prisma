// FitCoach persistence schema — implementation of docs/DATABASE_DESIGN.md v0.1.
//
// Conventions (design doc §2):
// - snake_case names via @@map/@map; tables plural; FK columns "<singular>_id".
// - Primary keys are application-generated UUIDv7 (approved decision 1); no
//   database-side gen_random_uuid() defaults on domain entities.
// - Timestamps timestamptz UTC. Mutable tables carry updated_at; immutable
//   observation tables deliberately omit it.
// - date columns are user-local days (users.timezone defines the day).
// - Exact numeric with explicit precision for physical/nutrition quantities.
// - Enum-like columns are text + CHECK constraints. CHECK constraints,
//   partial/expression unique indexes, GIN/INCLUDE indexes and append-only
//   triggers live in the SQL migrations (Prisma cannot express them); every
//   such column carries a comment listing its allowed values verbatim.
//
// History strategy (§5): observations/events are append-only; goals and plan
// content are interval-versioned; nutrition/targets/context values are
// snapshotted at write time; reference data is retired (is_active), never
// deleted.
//
// RLS note (approved decision 6): every user-owned table carries user_id (or
// cascades through a parent that does), so row-level security can be enabled
// later without schema changes. Application authorization must not rely on it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Cluster A — identity, profile history, goals, equipment inventory
// ---------------------------------------------------------------------------

model User {
  id             String  @id @db.Uuid
  email          String? @db.Text
  displayName    String? @map("display_name") @db.Text
  /// Reserved for the auth phase. UNIQUE (external_auth_id) partial in the
  /// design == PG UNIQUE (NULLs are distinct) — expressed as @unique.
  externalAuthId String? @unique @map("external_auth_id") @db.Text
  /// IANA timezone identifier (e.g. "Asia/Kolkata"); defines local-day math.
  /// CHECK (timezone <> '').
  timezone       String  @default("UTC") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile             Profile?
  profileRevisions    ProfileRevision[]
  goals               Goal[]
  userEquipment       UserEquipment[]
  exercisePreferences UserExercisePreference[]
  trainingPlans       TrainingPlan[]
  workouts            Workout[]
  bodyMeasurements    BodyMeasurement[]
  activityRecords     ActivityRecord[]
  ownedFoodSources    FoodSource[]             @relation("FoodSourceOwner")
  ownedRecipes        Recipe[]                 @relation("RecipeOwner")
  meals               Meal[]
  dailyNutrition      DailyNutrition[]
  diagnoses           Diagnosis[]
  recommendations     Recommendation[]
  interventions       Intervention[]
  trainingEnvironments TrainingEnvironmentPeriod[]
  progressionEvaluations ProgressionEvaluation[]
  sleepObservations     SleepObservation[]
  recoveryIndicators    RecoveryIndicator[]
  physiqueGoals         PhysiqueGoal[]
  projectionSnapshots   ProjectionSnapshot[]
  projectionDivergences ProjectionDivergence[]
  decisionSnapshots     DecisionSnapshot[]
  decisionOutcomes      DecisionOutcome[]
  conversations         Conversation[]

  // UNIQUE (external_auth_id) partial — @unique above.
  // UNIQUE (lower(email)) WHERE email IS NOT NULL — partial expression, in migration SQL.

  @@index([email])
  @@map("users")
}

/// Current personal characteristics used by calculations (§4.1).
/// Coaching-relevant attribute changes are recorded in ProfileRevision;
/// unit_system is presentation-only and deliberately not versioned
/// (approved decision 3).
model Profile {
  userId                 String    @id @map("user_id") @db.Uuid
  birthDate              DateTime? @map("birth_date") @db.Date
  /// CHECK in ('male','female','intersex','undisclosed') or NULL.
  sex                    String?   @db.Text
  /// numeric(5,1) CHECK > 0.
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 1)
  /// CHECK in ('untrained','beginner','intermediate','advanced') or NULL.
  trainingExperience     String?   @map("training_experience") @db.Text
  /// smallint CHECK BETWEEN 0 AND 7.
  trainingDaysPerWeek    Int?      @map("training_days_per_week") @db.SmallInt
  /// smallint CHECK > 0.
  sessionDurationMinutes Int?      @map("session_duration_minutes") @db.SmallInt
  /// Free-form tags; may reveal health conditions — special-category data.
  limitations            String[]  @default([])
  /// CHECK in ('metric','imperial'); display preference only, never versioned.
  unitSystem             String    @default("metric") @map("unit_system") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

/// Append-only history of coaching-relevant profile attributes (approved
/// decision 3). A revision is written only when a material field changes;
/// unit_system changes create no revision. Immutable (trigger-enforced).
model ProfileRevision {
  id                     String    @id @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  birthDate              DateTime? @map("birth_date") @db.Date
  sex                    String?   @db.Text
  heightCm               Decimal?  @map("height_cm") @db.Decimal(5, 1)
  trainingExperience     String?   @map("training_experience") @db.Text
  trainingDaysPerWeek    Int?      @map("training_days_per_week") @db.SmallInt
  sessionDurationMinutes Int?      @map("session_duration_minutes") @db.SmallInt
  /// Full material state at revision time.
  limitations            String[]  @default([])
  /// Which material fields changed in this revision.
  changedFields          String[]  @map("changed_fields")
  reason                 String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("profile_revisions")
}

/// Immutable, interval-versioned goal definitions (§6). Changing goals
/// creates a new row; content columns are frozen by convention (only
/// effective_until/superseded_by_goal_id move at supersession).
model Goal {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// Self-reference: goal that replaced this one. FK is DEFERRABLE INITIALLY
  /// DEFERRED in migration SQL (divergence D11): the linking UPDATE precedes
  /// the INSERT that creates the target row inside one transaction.
  supersededByGoalId String?   @map("superseded_by_goal_id") @db.Uuid
  /// CHECK in domain GoalKind values ('bodybuilding','aesthetics_v_taper',
  /// 'lean_recomposition','athletic_performance','max_strength',
  /// 'general_fitness','custom').
  kind               String    @db.Text
  description        String?   @db.Text
  /// User-local day the goal becomes effective.
  effectiveFrom      DateTime  @map("effective_from") @db.Date
  /// NULL = currently active. CHECK (effective_until IS NULL OR > effective_from).
  effectiveUntil     DateTime? @map("effective_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersededBy        Goal?           @relation("GoalSupersession", fields: [supersededByGoalId], references: [id], onDelete: SetNull)
  supersessions       Goal[]          @relation("GoalSupersession")
  physiqueTarget      PhysiqueTarget?
  priorities          GoalPriority[]
  activeDiagnoses     Diagnosis[]     @relation("DiagnosisActiveGoal")
  activeInterventions Intervention[]  @relation("InterventionActiveGoal")

  // PARTIAL UNIQUE (user_id) WHERE effective_until IS NULL — at most one
  // active goal per user; enforced in migration SQL.
  @@index([userId, effectiveFrom(sort: Desc)])
  @@map("goals")
}

/// Measurement targets belonging to one goal (1 : 0..1). Immutable with its
/// goal (append-only trigger).
model PhysiqueTarget {
  id                      String   @id @db.Uuid
  goalId                  String   @unique @map("goal_id") @db.Uuid
  /// numeric(6,2) CHECK > 0.
  bodyWeightKg            Decimal? @map("body_weight_kg") @db.Decimal(6, 2)
  /// numeric(4,1) CHECK BETWEEN 0 AND 60.
  bodyFatPercent          Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  /// numeric(6,1) CHECK > 0; all circumference targets nullable.
  waistCm                 Decimal? @map("waist_cm") @db.Decimal(6, 1)
  chestCm                 Decimal? @map("chest_cm") @db.Decimal(6, 1)
  shoulderCircumferenceCm Decimal? @map("shoulder_circumference_cm") @db.Decimal(6, 1)
  armCm                   Decimal? @map("arm_cm") @db.Decimal(6, 1)
  thighCm                 Decimal? @map("thigh_cm") @db.Decimal(6, 1)
  calfCm                  Decimal? @map("calf_cm") @db.Decimal(6, 1)
  notes                   String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  // CHECK that at least one target field IS NOT NULL — in migration SQL.
  @@map("physique_targets")
}

/// Ordered focus tags of a goal (domain Goal.priorities). Append-only.
model GoalPriority {
  id       String @id @db.Uuid
  goalId   String @map("goal_id") @db.Uuid
  /// 0 = most important. UNIQUE (goal_id, position).
  position Int    @db.SmallInt
  tag      String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, position])
  @@map("goal_priorities")
}

// ---------------------------------------------------------------------------
// Equipment catalog + per-user timed inventory (§4.3). Ownership is strictly
// per-user gym/inventory (approved decision 5); no shared-gym ownership yet.
// ---------------------------------------------------------------------------

/// Global catalog of equipment types. Reference data is retired
/// (is_active), never deleted.
model Equipment {
  id       String  @id @db.Uuid
  slug     String  @unique @db.Text
  name     String  @db.Text
  /// CHECK in domain EquipmentCategory values ('barbell','dumbbell',
  /// 'kettlebell','machine','cable','smith_machine','bench','rack',
  /// 'pull_up_bar','bands','bodyweight','cardio_machine','accessory','other').
  category String  @db.Text
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  userEquipment UserEquipment[]
  requiredBy    ExerciseRequiredEquipment[]

  @@map("equipment")
}

/// What equipment a specific user had, with validity interval so
/// "equipment at time T" is answerable. Replaces lossy boolean availability
/// (divergence D1). Past intervals remain as closed rows.
model UserEquipment {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  equipmentId    String    @map("equipment_id") @db.Uuid
  label          String?   @db.Text
  specifications Json?     @db.JsonB
  /// User-local day validity interval; NULL valid_to = still available.
  /// CHECK (valid_to IS NULL OR valid_to > valid_from).
  validFrom      DateTime  @map("valid_from") @db.Date
  validTo        DateTime? @map("valid_to") @db.Date
  /// Usability while the row is open (Phase 2 §16). CHECK in domain
  /// EquipmentAvailability values ('available','temporarily_unavailable',
  /// 'unavailable'). A lasting change is a new interval row, never an edit of
  /// history: the fitness-core universe filter consumes this column.
  availability   String    @default("available") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([userId, equipmentId, validFrom])
  @@index([userId, validFrom(sort: Desc)])
  @@map("user_equipment")
}

// ---------------------------------------------------------------------------
// Cluster B — reference catalog with provenance (§4.4, §10, §17).
// Global, licensed, shared across users, never deleted.
// ---------------------------------------------------------------------------

/// DB counterpart of data/provenance/THIRD_PARTY.md: origin + license of
/// third-party datasets. No exercise/muscle/food row may be imported from an
/// unverified source (CHECK + application gate).
model ExternalSource {
  id              String  @id @db.Uuid
  slug            String  @unique @db.Text
  name            String  @db.Text
  originUrl       String? @map("origin_url") @db.Text
  licenseSpdx     String? @map("license_spdx") @db.Text
  licenseVerified Boolean @default(false) @map("license_verified")
  registryRef     String? @map("registry_ref") @db.Text
  notes           String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  muscles                    Muscle[]
  exercises                  Exercise[]
  exerciseMuscleRelations    ExerciseMuscleRelation[]
  exerciseStructureRelations ExerciseMuscleStructureRelation[]
  formVersions               ExerciseFormVersion[]
  mediaAssets                ExerciseMediaAsset[]
  foodSources                FoodSource[]
  nutrientDefinitions        NutrientDefinition[]

  // CHECK (license_verified = false OR license_spdx IS NOT NULL) — in SQL.
  @@map("external_sources")
}

model Muscle {
  id               String  @id @db.Uuid
  externalSourceId String? @map("external_source_id") @db.Uuid
  slug             String  @unique @db.Text
  name             String  @db.Text
  /// CHECK in domain MuscleGroup values.
  group            String  @map("group") @db.Text
  displayName      String? @map("display_name") @db.Text
  /// Row identifier in the upstream dataset.
  externalId       String? @map("external_id") @db.Text
  isActive         Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalSource     ExternalSource?                   @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  relations          ExerciseMuscleRelation[]
  structures         MuscleStructure[]

  // UNIQUE (external_source_id, external_id) — NULLs are distinct in PG, so
  // this equals the design's partial unique WHERE external_id IS NOT NULL.
  @@unique([externalSourceId, externalId])
  @@map("muscles")
}

/// Phase 2 (§1): a head/region/portion of one muscle — biceps long head,
/// trapezius lower region, quadriceps vastus lateralis. Structures never
/// replace the muscle: every row rolls up to exactly one parent muscle, so
/// coverage math always has a parent to accumulate into.
///
/// Kind CHECK in ('head','region','portion'). Reference data: retired
/// (is_active), never deleted.
model MuscleStructure {
  id          String  @id @db.Uuid
  muscleId    String  @map("muscle_id") @db.Uuid
  slug        String  @db.Text
  name        String  @db.Text
  /// CHECK in ('head','region','portion').
  kind        String  @db.Text
  displayName String? @map("display_name") @db.Text
  notes       String? @db.Text
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  muscle    Muscle                            @relation(fields: [muscleId], references: [id], onDelete: Cascade)
  relations ExerciseMuscleStructureRelation[]

  // One structure slug per muscle: "biceps_brachii / long_head".
  @@unique([muscleId, slug])
  @@index([muscleId])
  @@map("muscle_structures")
}

model Exercise {
  id               String   @id @db.Uuid
  externalSourceId String?  @map("external_source_id") @db.Uuid
  slug             String   @unique @db.Text
  name             String   @db.Text
  aliases          String[] @default([])
  /// CHECK in domain ExerciseCategory values ('compound','isolation',
  /// 'conditioning','mobility','other').
  category         String   @db.Text
  /// CHECK in domain MovementPattern values, or NULL.
  movementPattern  String?  @map("movement_pattern") @db.Text
  unilateral       Boolean  @default(false)
  instructions     String?  @db.Text
  externalId       String?  @map("external_id") @db.Text
  isActive         Boolean  @default(true) @map("is_active")

  // --- Phase 2: exercise variation identity and intelligence ---------------
  /// Stable identity of the VARIATION, "<movement-slug>:<variation-slug>".
  /// Form guidance and media attach to this, so it survives renames.
  /// UNIQUE (variation_key) partial WHERE variation_key IS NOT NULL.
  variationKey                String? @map("variation_key") @db.Text
  /// Human label of the variation, e.g. "Wide-grip, pronated".
  variationLabel              String? @map("variation_label") @db.Text
  /// CHECK in ('high','moderate','low') — control demanded by the movement.
  stabilityDemand             String? @map("stability_demand") @db.Text
  /// CHECK in ('free_weight_multi_joint','free_weight_single_joint',
  /// 'machine_guided','cable_variable','cable_fixed',
  /// 'bodyweight_external_load','bodyweight_only','elastic_tension').
  loadingCharacteristic       String? @map("loading_characteristic") @db.Text
  /// CHECK in ('full_stretch_to_squeeze','stretch_emphasised',
  /// 'shortened_emphasised','partial_rom').
  rangeOfMotionCharacteristic String? @map("range_of_motion_characteristic") @db.Text
  /// Version of the attached knowledge (targeting/form/media). Bumped by the
  /// catalog import; exercise identity itself never changes.
  knowledgeVersion            Int     @default(1) @map("knowledge_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  externalSource       ExternalSource?                   @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  requiredEquipment    ExerciseRequiredEquipment[]
  muscleRelations      ExerciseMuscleRelation[]
  structureRelations   ExerciseMuscleStructureRelation[]
  formVersions         ExerciseFormVersion[]
  mediaAssets          ExerciseMediaAsset[]
  workoutExercises     WorkoutExercise[]
  planSlots            TrainingPlanExerciseSlot[]
  userPreferences      UserExercisePreference[]

  // UNIQUE (external_source_id, external_id) partial == PG UNIQUE (NULLs distinct).
  @@unique([externalSourceId, externalId])
  @@index([externalSourceId])
  @@index([movementPattern])
  @@index([variationKey])
  @@map("exercises")
}

model ExerciseRequiredEquipment {
  exerciseId   String @map("exercise_id") @db.Uuid
  equipmentId  String @map("equipment_id") @db.Uuid
  /// 0 = required, 1 = optional, 2 = alternative.
  priority     Int    @db.SmallInt
  quantity     Int    @default(1) @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@id([exerciseId, equipmentId])
  @@index([equipmentId])
  @@map("exercise_required_equipment")
}

model ExerciseMuscleRelation {
  id              String   @id @db.Uuid
  exerciseId      String   @map("exercise_id") @db.Uuid
  muscleId        String   @map("muscle_id") @db.Uuid
  externalSourceId String? @map("external_source_id") @db.Uuid
  /// CHECK in domain MuscleRole values ('primary','secondary','stabilizer').
  role            String   @db.Text
  /// numeric(3,2) CHECK BETWEEN 0 AND 1.
  emphasis        Decimal  @db.Decimal(3, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise      Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  muscle        Muscle        @relation(fields: [muscleId], references: [id], onDelete: Restrict)
  externalSource ExternalSource? @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)

  @@unique([exerciseId, muscleId, role])
  @@index([muscleId])
  @@index([externalSourceId])
  @@map("exercise_muscle_relations")
}

model ExerciseMuscleStructureRelation {
  id              String   @id @db.Uuid
  exerciseId      String   @map("exercise_id") @db.Uuid
  structureId     String   @map("structure_id") @db.Uuid
  externalSourceId String? @map("external_source_id") @db.Uuid
  /// CHECK in domain MuscleRole values ('primary','secondary','stabilizer').
  role            String   @db.Text
  /// numeric(3,2) CHECK BETWEEN 0 AND 1.
  emphasis        Decimal  @db.Decimal(3, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise       Exercise           @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  structure      MuscleStructure    @relation(fields: [structureId], references: [id], onDelete: Restrict)
  externalSource ExternalSource?    @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)

  @@unique([exerciseId, structureId, role])
  @@index([structureId])
  @@index([externalSourceId])
  @@map("exercise_muscle_structure_relations")
}

model ExerciseFormVersion {
  id              String   @id @db.Uuid
  exerciseId      String   @map("exercise_id") @db.Uuid
  externalSourceId String? @map("external_source_id") @db.Uuid
  /// CHECK in ('key_points','common_faults','setup','execution','breathing','progression').
  section         String   @db.Text
  content         String   @db.Text
  /// CHECK in ('demonstration','explanation','fault','cue','progression').
  kind            String   @db.Text
  position        Int      @db.SmallInt
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise       Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  externalSource ExternalSource?    @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  mediaAssets    ExerciseMediaAsset[]

  @@unique([exerciseId, section, kind, position])
  @@index([exerciseId])
  @@index([externalSourceId])
  @@map("exercise_form_versions")
}

model ExerciseMediaAsset {
  id              String   @id @db.Uuid
  exerciseId      String   @map("exercise_id") @db.Uuid
  formVersionId   String?  @map("form_version_id") @db.Uuid
  externalSourceId String? @map("external_source_id") @db.Uuid
  /// CHECK in ('video','image','gif','animation').
  type            String   @db.Text
  url             String   @db.Text
  /// CHECK in ('front','side','back','top','angle','other').
  angle           String?  @db.Text
  caption         String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercise       Exercise             @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  formVersion    ExerciseFormVersion? @relation(fields: [formVersionId], references: [id], onDelete: SetNull)
  externalSource ExternalSource?      @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)

  @@index([exerciseId])
  @@index([formVersionId])
  @@index([externalSourceId])
  @@map("exercise_media_assets")
}

model UserExercisePreference {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  exerciseId  String    @map("exercise_id") @db.Uuid
  /// CHECK in ('preferred','disliked','unavailable','injury_avoidance').
  preference  String    @db.Text
  notes       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise  Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([userId, exerciseId])
  @@index([userId])
  @@map("user_exercise_preferences")
}

// ---------------------------------------------------------------------------
// Cluster C — training plans & progression (§4.5, Phase 3)
// ---------------------------------------------------------------------------

model TrainingPlan {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  name            String    @db.Text
  description     String?   @db.Text
  /// CHECK in ('active','archived','draft').
  status          String    @db.Text
  /// User-local day when plan became active.
  activeFrom      DateTime? @map("active_from") @db.Date
  /// User-local day when plan was archived.
  activeUntil     DateTime? @map("active_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions    TrainingPlanVersion[]
  workouts    Workout[]
  progressionEvaluations ProgressionEvaluation[]

  // PARTIAL UNIQUE (user_id) WHERE status = 'active' — in SQL.
  @@index([userId, activeFrom(sort: Desc)])
  @@map("training_plans")
}

model TrainingPlanVersion {
  id           String   @id @db.Uuid
  planId       String   @map("plan_id") @db.Uuid
  /// CHECK in ('active','superseded','draft').
  status       String   @db.Text
  /// JSON blob of the full plan (sessions, exercises, progression rules).
  planJson     String   @map("plan_json") @db.Text
  /// Configuration version used to generate this plan.
  configVersion String? @map("config_version") @db.Text
  /// Previous version this one supersedes.
  supersedesId String?  @map("supersedes_id") @db.Uuid
  /// User-local day this version became active.
  effectiveFrom DateTime @map("effective_from") @db.Date
  /// User-local day this version was superseded.
  effectiveUntil DateTime? @map("effective_until") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan         TrainingPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  supersedes   TrainingPlanVersion?      @relation("TrainingPlanVersionSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersessions TrainingPlanVersion[]    @relation("TrainingPlanVersionSupersession")
  sessions     TrainingPlanSession[]
  progressionEvaluations ProgressionEvaluation[]
  workouts              Workout[]                 @relation("WorkoutPlanVersion")
  diagnoses             Diagnosis[]               @relation("DiagnosisActivePlanVersion")
  interventions         Intervention[]            @relation("InterventionActivePlanVersion")
  constraints           TrainingPlanConstraint[]
  decisions             TrainingPlanDecision[]

  // PARTIAL UNIQUE (plan_id) WHERE effective_until IS NULL — at most one
  // active version per plan; enforced in migration SQL.
  @@index([planId, effectiveFrom(sort: Desc)])
  @@map("training_plan_versions")
}

model TrainingPlanSession {
  id          String    @id @db.Uuid
  versionId   String    @map("version_id") @db.Uuid
  /// 0 = first session of the week. CHECK in (0..6).
  dayOfWeek   Int       @db.SmallInt
  name        String?   @db.Text
  notes       String?   @db.Text
  estimatedDurationMinutes Int? @map("estimated_duration_minutes") @db.SmallInt

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  version   TrainingPlanVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  slots     TrainingPlanExerciseSlot[]
  workouts  Workout[]

  @@unique([versionId, dayOfWeek])
  @@index([versionId])
  @@map("training_plan_sessions")
}

model TrainingPlanExerciseSlot {
  id          String    @id @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  exerciseId  String    @map("exercise_id") @db.Uuid
  /// Order within the session.
  position    Int       @db.SmallInt
  /// Target sets for this slot. CHECK > 0.
  targetSets  Int       @db.SmallInt
  /// Target rep range, e.g. "8-12". CHECK in domain RepRange format.
  targetReps  String    @db.Text
  /// Target RIR. numeric(3,1) CHECK BETWEEN 0 AND 3.
  targetRir   Decimal   @db.Decimal(3, 1)
  /// Load prescription: 'percentage_1rm' | 'rpe' | 'load_kg' | 'bodyweight' | 'as_many_as_possible'.
  loadPrescription String  @map("load_prescription") @db.Text
  /// Value for the load prescription (e.g., 75 for percentage_1rm).
  loadValue   Decimal?  @map("load_value") @db.Decimal(7, 2)
  /// Progression rule attached to this slot (Phase 3 §19).
  progressionRule TrainingPlanProgressionRule?
  notes       String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  session      TrainingPlanSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise     Exercise                       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  workoutExercises WorkoutExercise[]          @relation("WorkoutExerciseSlot")
  progressionEvaluations ProgressionEvaluation[]

  @@unique([sessionId, position])
  @@index([exerciseId])
  @@map("training_plan_exercise_slots")
}

model TrainingEnvironmentPeriod {
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// CHECK in TrainingEnvironmentKind values.
  kind         String    @db.Text
  /// User-local day validity interval.
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  /// JSON of available equipment, constraints, etc.
  config       Json      @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, validFrom])
  @@index([userId, validFrom(sort: Desc)])
  @@map("training_environment_periods")
}

model ProgressionEvaluation {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  exerciseId      String    @map("exercise_id") @db.Uuid
  exerciseName    String    @map("exercise_name") @db.Text
  planId          String?   @map("plan_id") @db.Uuid
  planVersionId   String?   @map("plan_version_id") @db.Uuid
  slotId          String?   @map("slot_id") @db.Uuid
  /// CHECK in domain TrainingEnvironmentKind values.
  environmentKind String?   @map("environment_kind") @db.Text
  /// The observation that triggered the evaluation.
  current         Json      @map("current") @db.JsonB
  /// The observation it is compared against.
  previous        Json?     @map("previous") @db.JsonB
  /// Snapshot of the summary the evaluation used.
  performance     Json      @map("performance") @db.JsonB
  /// CHECK in domain ProgressionEvaluationOutcome values.
  outcome         String    @map("outcome") @db.Text
  /// Full recommendation object.
  recommendation  Json      @map("recommendation") @db.JsonB
  /// Evidence strings.
  evidence        String[]  @default([]) @db.Text
  /// Deterministic dedupe key.
  fingerprint     String    @map("fingerprint") @db.Text
  /// Configuration version.
  configVersion   String    @map("config_version") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan         TrainingPlan?            @relation(fields: [planId], references: [id], onDelete: SetNull)
  planVersion  TrainingPlanVersion?     @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  slot         TrainingPlanExerciseSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  events       ProgressionDecisionEvent[]

  @@unique([planVersionId, slotId, fingerprint])
  @@index([userId, createdAt(sort: Desc)])
  @@map("progression_evaluations")
}

model ProgressionDecisionEvent {
  id                String    @id @db.Uuid
  evaluationId      String    @map("evaluation_id") @db.Uuid
  /// CHECK in domain ProgressionDecisionKind values ('recommended','accepted','rejected','deferred').
  decision          String    @db.Text
  /// Human-readable reason for the decision.
  reason            String?   @db.Text
  /// Idempotency key for the decision event itself.
  idempotencyKey    String?   @map("idempotency_key") @db.Text
  /// What actually changed (load/reps/variation) or {"kind":"none"}.
  actualChange      Json?     @map("actual_change") @db.JsonB
  /// Performance observed afterwards, when the client reports it.
  resultingPerformance Json?  @map("resulting_performance") @db.JsonB
  evidence          String[]  @default([]) @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  evaluation ProgressionEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, idempotencyKey])
  @@index([evaluationId, createdAt])
  @@map("progression_decision_events")
}

/// Deterministic progression rule attached to one planned exercise slot
/// (Phase 3 §19). Content is frozen with its plan version.
model TrainingPlanProgressionRule {
  id     String @id @db.Uuid
  slotId String @map("slot_id") @db.Uuid
  /// What starts the rule, e.g. `complete_sessions_at_top_of_rep_range`.
  trigger String @db.Text
  condition String @db.Text
  /// CHECK in domain `ProgressionAction` values.
  action  String @db.Text
  bounds  String @db.Text
  resetBehavior String? @map("reset_behavior") @db.Text
  rationale String @db.Text
  configVersion String? @map("config_version") @db.Text

  slot TrainingPlanExerciseSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@unique([slotId])
  @@map("training_plan_progression_rules")
}

/// Constraint evaluated against a plan version (Phase 3 §15).
/// Each version carries its constraint results frozen at generation time.
model TrainingPlanConstraint {
  id           String   @id @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  /// Machine-readable constraint key, e.g. "exercise_availability", "session_duration".
  constraintKey String  @map("constraint_key") @db.Text
  /// Human-readable label shown in UI.
  label        String   @db.Text
  /// Result: "satisfied" | "violated" | "warning"
  result       String   @db.Text
  /// Hard constraints must be satisfied for feasibility.
  isHard       Boolean  @map("is_hard")
  /// Detail when violated.
  violationDetail String? @map("violation_detail") @db.Text
  /// Detail when warning.
  warningDetail String? @map("warning_detail") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version TrainingPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("training_plan_constraints")
}

/// Adaptation decision recorded against a plan version (Phase 3 §16-18).
/// Decisions are immutable once created; a new decision = a new version.
model TrainingPlanDecision {
  id           String   @id @db.Uuid
  versionId    String   @map("version_id") @db.Uuid
  /// Decision kind: "no_change" | "volume_adjustment" | "frequency_adjustment" | etc.
  kind         String   @db.Text
  /// Human-readable rationale.
  rationale    String   @db.Text
  /// Structured parameters for the decision (JSON).
  parameters   Json     @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  version TrainingPlanVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("training_plan_decisions")
}

// ---------------------------------------------------------------------------
// Workouts (events) — what actually happened (§4.6)
// ---------------------------------------------------------------------------

/// A training session that happened (or was planned/skipped). Content is
/// editable only until completion; afterwards repositories refuse mutations
/// and corrections happen via new records (approved decision 2).
model Workout {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  planId          String?   @map("plan_id") @db.Uuid
  /// Which plan version produced this workout.
  planVersionId   String?   @map("plan_version_id") @db.Uuid
  planSessionId   String?   @map("plan_session_id") @db.Uuid
  title           String?   @db.Text
  /// CHECK in ('planned','in_progress','completed','partial','skipped').
  status          String    @db.Text
  startedAt       DateTime  @map("started_at") @db.Timestamptz(6)
  /// CHECK (ended_at IS NULL OR ended_at > started_at).
  endedAt         DateTime? @map("ended_at") @db.Timestamptz(6)
  notes           String?   @db.Text
  /// Idempotency key for retries (§15).
  clientRequestId String?   @map("client_request_id") @db.Text

  // Phase 3.1 — the environment the session was actually performed in, and how
  // it relates to the plan. "Adapted" is completed training in a different
  // environment; it must never be silently equal to the planned session, and it
  // must never be recorded as MISSED either.
  /// CHECK in TrainingEnvironmentKind values, or NULL (unknown / gym default).
  environmentKind       String? @map("environment_kind") @db.Text
  /// CHECK in ('planned','adapted','makeup','unplanned'), or NULL.
  sessionClassification String? @map("session_classification") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        TrainingPlan?        @relation(fields: [planId], references: [id], onDelete: SetNull)
  planVersion TrainingPlanVersion? @relation("WorkoutPlanVersion", fields: [planVersionId], references: [id], onDelete: Restrict)
  planSession TrainingPlanSession? @relation(fields: [planSessionId], references: [id], onDelete: SetNull)
  exercises   WorkoutExercise[]

  // Semantically the partial UNIQUE (user_id, client_request_id) WHERE NOT
  // NULL: PostgreSQL treats NULL as distinct in composite unique constraints,
  // so rows without a client_request_id never collide.
  @@unique([userId, clientRequestId])
  // PARTIAL INDEX (user_id) WHERE status IN ('planned','in_progress') — in SQL.
  @@index([userId, startedAt(sort: Desc)])
  @@index([planVersionId])
  @@map("workouts")
}

/// Groups a workout's sets per exercise with order and block-level notes.
model WorkoutExercise {
  id         String  @id @db.Uuid
  workoutId  String  @map("workout_id") @db.Uuid
  exerciseId String  @map("exercise_id") @db.Uuid
  /// UNIQUE (workout_id, position).
  position   Int
  notes      String? @db.Text

  // Phase 3.1 — link performed work back to the plan slot it fulfilled, and
  // record that the movement was a substitution (so history never claims the
  // user performed something they did not).
  /// Planned slot this group fulfilled; NULL for unplanned training.
  slotId        String? @map("slot_id") @db.Uuid
  /// Exercise this one replaced, when performed as a substitution.
  substitutedFromExerciseId String? @map("substituted_from_exercise_id") @db.Uuid
  /// CHECK in ('manual','imported','inferred'), or NULL (unknown).
  performanceSource String? @map("performance_source") @db.Text
  /// Trainer/athlete note about the substitution itself.
  substitutionReason String? @map("substitution_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workout  Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  slot     TrainingPlanExerciseSlot? @relation("WorkoutExerciseSlot", fields: [slotId], references: [id], onDelete: SetNull)
  sets     ExerciseSet[]

  @@unique([workoutId, position])
  @@index([exerciseId])
  @@index([slotId])
  @@map("workout_exercises")
}

/// The atomic performance observation (load/reps/RIR/RPE...). Editable until
/// the parent workout completes; frozen afterwards (application-enforced).
model ExerciseSet {
  id                String   @id @db.Uuid
  workoutExerciseId String   @map("workout_exercise_id") @db.Uuid
  /// UNIQUE per (workout_exercise_id, position) index in migration SQL.
  position          Int
  /// CHECK in ('warmup','working','drop_set','rest_pause','amrap','failure').
  kind              String   @db.Text
  /// numeric(7,2) CHECK >= 0; NULL = bodyweight movement.
  loadKg            Decimal? @map("load_kg") @db.Decimal(7, 2)
  /// Weight added to bodyweight movements. numeric(7,2) CHECK >= 0.
  addedLoadKg       Decimal? @map("added_load_kg") @db.Decimal(7, 2)
  /// smallint CHECK BETWEEN 0 AND 1000.
  reps              Int?     @db.SmallInt
  /// numeric(8,2) CHECK >= 0.
  distanceMeters    Decimal? @map("distance_meters") @db.Decimal(8, 2)
  /// integer CHECK >= 0.
  durationSeconds   Int?     @map("duration_seconds")
  /// numeric(3,1) CHECK BETWEEN 0 AND 10.
  rir               Decimal? @db.Decimal(3, 1)
  /// numeric(3,1) CHECK BETWEEN 0 AND 10.
  rpe               Decimal? @db.Decimal(3, 1)
  notes             String?  @db.Text

  // Phase 3.1 — distinguish bodyweight / weighted-bodyweight / assisted load
  // instead of forcing every movement into an external-load column, and make a
  // retried submission idempotent.
  /// CHECK in PerformanceLoadKind values, or NULL (inferred from columns).
  loadKind          String?  @map("load_kind") @db.Text
  /// Assistance that reduced effective load. numeric(7,2) CHECK >= 0.
  assistanceLoadKg  Decimal? @map("assistance_load_kg") @db.Decimal(7, 2)
  /// Idempotency key for set-level retries (§32).
  clientRequestId   String?  @map("client_request_id") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  workoutExercise WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  // CHECK that at least one measurable exists:
  // (reps OR distance_meters OR duration_seconds) IS NOT NULL — in SQL.
  @@unique([workoutExerciseId, clientRequestId])
  @@index([workoutExerciseId, position])
  @@map("exercise_sets")
}

// ---------------------------------------------------------------------------
// Cluster D — body & nutrition (§4.7, §4.8)
// ---------------------------------------------------------------------------

/// Point-in-time body observation. Append-only (trigger-enforced):
/// corrections add new rows (§9, approved decision 2).
model BodyMeasurement {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// When measured (distinct from created_at logging time).
  recordedAt     DateTime @map("recorded_at") @db.Timestamptz(6)
  /// CHECK in ('morning_fasted','post_workout','evening','random','other').
  condition      String?  @db.Text
  /// numeric(6,2) CHECK > 0.
  bodyWeightKg   Decimal? @map("body_weight_kg") @db.Decimal(6, 2)
  /// numeric(4,1) CHECK BETWEEN 0 AND 60.
  bodyFatPercent Decimal? @map("body_fat_percent") @db.Decimal(4, 1)
  /// CHECK in ('manual','smart_scale_import','wearable_import','other').
  enteredVia     String?  @map("entered_via") @db.Text
  /// CHECK in ('measured','estimated','unknown').
  confidence     String?  @db.Text
  sourceName     String?  @map("source_name") @db.Text
  /// Provider event id for import dedupe (§15).
  externalId     String?  @map("external_id") @db.Text
  /// Object-storage keys only — binaries never in the DB (§16). Empty array
  /// instead of NULL (Prisma cannot express nullable arrays; divergence D8).
  photoRefs      String[] @default([]) @map("photo_refs")
  notes          String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  values BodyMeasurementValue[]

  // CHECK that at least one measurement datum exists (weight, fat%, or ≥1
  // circumference row — child-row part enforced by the repository);
  // expression UNIQUE (user_id, entered_via, external_id) WHERE
  // COALESCE(external_id,'') <> '' — both in migration SQL.
  @@index([userId, recordedAt(sort: Desc)])
  @@index([externalId])
  @@map("body_measurements")
}

/// Normalized circumferences per site (domain Partial<Record<BodySite,...>>).
/// Append-only with its parent (trigger-enforced).
model BodyMeasurementValue {
  measurementId String  @map("measurement_id") @db.Uuid
  /// CHECK in domain BodySite values.
  site          String  @db.Text
  /// numeric(6,1) CHECK > 0.
  valueCm       Decimal @map("value_cm") @db.Decimal(6, 1)

  measurement BodyMeasurement @relation(fields: [measurementId], references: [id], onDelete: Cascade)

  @@id([measurementId, site])
  // INDEX (site) INCLUDE (value_cm) — in migration SQL.
  @@map("body_measurement_values")
}

/// Physique goal — ordered priorities with direction and timeframe. Mutable
/// content is interval-versioned like Goal (§6). One active goal per user.
model PhysiqueGoal {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  /// Interval versioning: NULL = currently active.
  effectiveFrom        DateTime @map("effective_from") @db.Date
  effectiveUntil       DateTime? @map("effective_until") @db.Date
  /// Ordered priority tags. Stored as child rows for ordering integrity.
  priorities           PhysiqueGoalPriority[]
  /// Custom user-defined priorities beyond the standard tags.
  customPriorities     Json?    @map("custom_priorities") @db.JsonB
  /// Target timeframe in weeks (1..104).
  targetTimeframeWeeks Int?     @map("target_timeframe_weeks") @db.SmallInt
  /// CHECK in ('maintain','gain','lose','recomp').
  direction            String   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PARTIAL UNIQUE (user_id) WHERE effective_until IS NULL — at most one
  // active physique goal per user; enforced in migration SQL.
  @@index([userId, effectiveFrom(sort: Desc)])
  @@map("physique_goals")
}

/// Ordered focus tags of a physique goal. Append-only with parent.
model PhysiqueGoalPriority {
  id           String @id @db.Uuid
  physiqueGoalId String @map("physique_goal_id") @db.Uuid
  /// 0 = most important. UNIQUE (physique_goal_id, position).
  position     Int    @db.SmallInt
  /// CHECK in domain PhysiquePriorityTag values.
  tag          String @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  physiqueGoal PhysiqueGoal @relation(fields: [physiqueGoalId], references: [id], onDelete: Cascade)

  @@unique([physiqueGoalId, position])
  @@map("physique_goal_priorities")
}

/// Daily steps aggregate + discrete activity sessions. Append-only;
/// the ONLY sanctioned mutation is the cumulative-steps import upsert
/// (max wins, §15), which repositories expose as a dedicated operation.
model ActivityRecord {
  id                      String   @id @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  /// User-local day (users.timezone).
  date                    DateTime @db.Date
  /// CHECK in ('steps','walk','run','cycle','row','swim','elliptical',
  /// 'stairs','sport','other').
  kind                    String   @db.Text
  /// Only meaningful for kind='steps'. integer CHECK >= 0.
  steps                   Int?
  /// integer CHECK >= 0.
  durationMinutes         Int?     @map("duration_minutes")
  /// numeric(7,3) CHECK >= 0.
  distanceKm              Decimal? @map("distance_km") @db.Decimal(7, 3)
  /// smallint CHECK BETWEEN 20 AND 260.
  averageHeartRateBpm     Int?     @map("average_heart_rate_bpm") @db.SmallInt
  /// numeric(7,2) CHECK >= 0.
  estimatedCaloriesBurned Decimal? @map("estimated_calories_burned") @db.Decimal(7, 2)
  /// CHECK in ('low','moderate','high').
  effort                  String?  @db.Text
  recordedVia             String?  @map("recorded_via") @db.Text
  externalId              String?  @map("external_id") @db.Text
  notes                   String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // CHECK (kind <> 'steps' OR steps IS NOT NULL) and
  // CHECK (kind = 'steps' OR steps IS NULL) — steps live only on step rows.
  // PARTIAL UNIQUE (user_id, date, recorded_via) WHERE kind = 'steps'
  // (one cumulative value per source/day → idempotent upsert).
  // All in migration SQL.
  @@index([userId, date(sort: Desc)])
  @@index([userId, kind, date(sort: Desc)])
  @@index([externalId])
  @@map("activity_records")
}

// ---------------------------------------------------------------------------
// Cluster D (cont.) — nutrition: sources → foods → servings; recipes;
// meals (snapshotted) → daily aggregates (§4.8, §8)
// ---------------------------------------------------------------------------

/// Origin + default trust level of food data. User-created sources belong to
/// their owner; curated/imported sources are global.
model FoodSource {
  id                String  @id @db.Uuid
  ownerUserId       String? @map("owner_user_id") @db.Uuid
  externalSourceId  String? @map("external_source_id") @db.Uuid
  name              String  @db.Text
  /// CHECK in ('curated_database','user_created','imported','estimate').
  kind              String  @db.Text
  /// CHECK in ('measured','label_declared','estimated','unknown').
  defaultConfidence String  @map("default_confidence") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner          User?           @relation("FoodSourceOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  externalSource ExternalSource? @relation(fields: [externalSourceId], references: [id], onDelete: SetNull)
  foods          Food[]

  // CHECK (kind <> 'user_created' OR owner_user_id IS NOT NULL) — in SQL.
  @@index([ownerUserId])
  @@index([externalSourceId])
  @@map("food_sources")
}

/// Canonical food with nutrient density per 100 g/ml. Reference data:
/// retired (is_active), never deleted — history depends on it.
model Food {
  id               String   @id @db.Uuid
  sourceId         String   @map("source_id") @db.Uuid
  defaultServingId String?  @map("default_serving_id") @db.Uuid
  name             String   @db.Text
  brand            String?  @db.Text
  /// CHECK ('per_100g','per_100ml').
  densityBasis     String   @map("density_basis") @db.Text
  // Nutrient density columns; NUMERIC CHECK >= 0 (constraints in SQL).
  caloriesKcal     Decimal  @map("calories_kcal") @db.Decimal(9, 2)
  proteinG         Decimal  @map("protein_g") @db.Decimal(8, 3)
  carbohydrateG    Decimal  @map("carbohydrate_g") @db.Decimal(8, 3)
  fatG             Decimal  @map("fat_g") @db.Decimal(8, 3)
  fiberG           Decimal? @map("fiber_g") @db.Decimal(8, 3)
  sugarsG          Decimal? @map("sugars_g") @db.Decimal(8, 3)
  saturatedFatG    Decimal? @map("saturated_fat_g") @db.Decimal(8, 3)
  alcoholG         Decimal? @map("alcohol_g") @db.Decimal(8, 3)
  sodiumMg         Decimal? @map("sodium_mg") @db.Decimal(9, 3)
  /// NULL = non-scannable. UNIQUE(barcode) partial in design == PG UNIQUE
  /// (NULLs are distinct) — expressed as @unique here.
  barcode          String?  @unique @db.Text
  externalId       String?  @map("external_id") @db.Text
  isActive         Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // CASCADE (not design's RESTRICT): food_sources.owner_user_id cascades from
  // users, so user-created sources must take their foods with them on account
  // erasure (divergence D11).
  source         FoodSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  defaultServing FoodServing?  @relation("FoodDefaultServing", fields: [defaultServingId], references: [id], onDelete: SetNull)
  servings       FoodServing[]
  recipeItems    RecipeItem[]
  mealItems      MealItem[]
  nutrientValues FoodNutrientValue[]

  // UNIQUE (source_id, external_id) partial == PG UNIQUE (NULLs distinct).
  @@unique([sourceId, externalId])
  @@index([sourceId])
  @@index([name])
  // GIN index on aliases — in migration SQL.
  @@map("foods")
}

/// Named serving definition of a food. Exactly one size basis (SQL CHECK).
model FoodServing {
  id           String   @id @db.Uuid
  foodId       String   @map("food_id") @db.Uuid
  label        String   @db.Text
  grams        Decimal? @db.Decimal(8, 2)
  milliliters  Decimal? @db.Decimal(8, 2)
  unitQuantity Decimal? @map("unit_quantity") @db.Decimal(8, 2)
  unitName     String?  @map("unit_name") @db.Text

  defaultForFood Food[] @relation("FoodDefaultServing")
  food           Food   @relation(fields: [foodId], references: [id], onDelete: Cascade)

  // CHECK: exactly one of (grams XOR milliliters) or (unit_quantity+unit_name).
  @@unique([foodId, label])
  @@index([foodId])
  @@map("food_servings")
}

/// Phase 4 V2: Canonical nutrient definition registry.
/// One row per nutrient (e.g., "calories_kcal", "vitamin_d", "iron_mg").
/// Reference data: retired (is_active), never deleted.
model NutrientDefinition {
  id            String  @id @db.Uuid
  /// Stable machine key, e.g. 'calories_kcal', 'vitamin_d', 'iron_mg'
  key           String  @unique @db.Text
  /// Human-readable name for UI
  displayName   String  @map("display_name") @db.Text
  /// Canonical unit: 'kcal' | 'kj' | 'g' | 'mg' | 'mcg' | 'iu'
  unit          String  @db.Text
  /// Category for grouping in UI: 'energy' | 'macronutrient' | 'fiber' | 'sugar' |
  /// 'fat_detail' | 'mineral' | 'vitamin' | 'amino_acid' | 'other'
  category      String  @db.Text
  /// Default display precision (decimal places)
  precision     Int     @default(2) @db.SmallInt
  /// Reference daily intake (RDI) for %DV calculations, when established
  rdiValue      Decimal? @map("rdi_value") @db.Decimal(12, 4)
  rdiUnit       String? @map("rdi_unit") @db.Text
  /// Ordering in nutrient lists
  sortOrder     Int     @default(0) @map("sort_order") @db.SmallInt
  /// Source this definition came from (for audit)
  sourceId      String? @map("source_id") @db.Uuid
  /// Whether this is a core nutrient (always present in foods table snapshot)
  isCore        Boolean @default(false) @map("is_core")
  /// Active flag (retired, never deleted)
  isActive      Boolean @default(true) @map("is_active")

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  source        ExternalSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  foodValues    FoodNutrientValue[]

  @@index([category])
  @@index([isCore])
  @@index([sortOrder])
  @@map("nutrient_definitions")
}

/// Phase 4 V2: Per-food nutrient values with full provenance.
/// Replaces flat nutrient columns on foods with a flexible, provenance-aware registry.
/// Existing foods.nutrients_* columns remain for backwards compatibility.
model FoodNutrientValue {
  id                  String  @id @db.Uuid
  foodId              String  @map("food_id") @db.Uuid
  nutrientId          String  @map("nutrient_id") @db.Uuid
  /// Amount per 100g (or per 100ml for density_basis = 'per_100ml')
  amountPer100        Decimal @map("amount_per_100") @db.Decimal(12, 4)
  /// Confidence in this value
  confidence          String  @db.Text
  /// Provenance tier
  provenanceTier      String  @map("provenance_tier") @db.Text
  /// Preparation state this value applies to
  preparationState    String? @map("preparation_state") @db.Text
  /// Preparation method detail
  preparationMethod   String? @map("preparation_method") @db.Text
  /// Optional uncertainty range for estimates
  uncertaintyLow      Decimal? @map("uncertainty_low") @db.Decimal(12, 4)
  uncertaintyHigh     Decimal? @map("uncertainty_high") @db.Decimal(12, 4)
  /// Source dataset row identifier
  externalId          String? @map("external_id") @db.Text
  /// When this value was measured/recorded
  measuredAt          DateTime? @map("measured_at") @db.Timestamptz(6)
  /// Notes from the data source
  notes               String? @db.Text

  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  food                Food                @relation(fields: [foodId], references: [id], onDelete: Cascade)
  nutrient            NutrientDefinition  @relation(fields: [nutrientId], references: [id], onDelete: Restrict)

  @@unique([foodId, nutrientId, preparationState])
  @@index([foodId])
  @@index([nutrientId])
  @@index([provenanceTier])
  @@map("food_nutrient_values")
}

/// Reusable food composition. owner NULL = global/shared.
model Recipe {
  id           String  @id @db.Uuid
  ownerUserId  String? @map("owner_user_id") @db.Uuid
  name         String  @db.Text
  /// Portions the item quantities produce. integer CHECK > 0.
  servings     Int
  instructions String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User?        @relation("RecipeOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  items     RecipeItem[]
  mealItems MealItem[]

  @@index([ownerUserId])
  @@index([name])
  @@map("recipes")
}

/// Food quantities composing a recipe.
model RecipeItem {
  id            String  @id @db.Uuid
  recipeId      String  @map("recipe_id") @db.Uuid
  foodId        String  @map("food_id") @db.Uuid
  /// numeric(9,2) CHECK > 0.
  quantityGrams Decimal @map("quantity_grams") @db.Decimal(9, 2)
  position      Int
  notes         String? @db.Text

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  food   Food   @relation(fields: [foodId], references: [id], onDelete: Restrict)

  @@unique([recipeId, position])
  @@index([foodId])
  @@map("recipe_items")
}

/// A logged eating occasion with nutrition snapshot totals (§8).
/// Totals refresh when items change; item-level snapshots never do.
model Meal {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// User-local day (users.timezone).
  localDate          DateTime  @map("local_date") @db.Date
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(6)
  /// CHECK in ('breakfast','lunch','dinner','snack','other').
  slot               String?   @db.Text
  // Snapshot totals; NUMERIC CHECK >= 0 (in SQL).
  totalCaloriesKcal  Decimal   @map("total_calories_kcal") @db.Decimal(10, 2)
  totalProteinG      Decimal   @map("total_protein_g") @db.Decimal(9, 3)
  totalCarbohydrateG Decimal   @map("total_carbohydrate_g") @db.Decimal(9, 3)
  totalFatG          Decimal   @map("total_fat_g") @db.Decimal(9, 3)
  totalFiberG        Decimal?  @map("total_fiber_g") @db.Decimal(9, 3)
  notes              String?   @db.Text
  /// Idempotency key for retries (§15).
  clientRequestId    String?   @map("client_request_id") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items MealItem[]

  // Semantically partial UNIQUE (user_id, client_request_id) WHERE NOT NULL.
  @@unique([userId, clientRequestId])
  @@index([userId, localDate(sort: Desc)])
  @@map("meals")
}

/// One consumed line of a meal, with snapshotted nutrients. The snapshot is
/// computed once at logging time; later food-database edits never touch it.
model MealItem {
  id             String   @id @db.Uuid
  mealId         String   @map("meal_id") @db.Uuid
  foodId         String?  @map("food_id") @db.Uuid
  recipeId       String?  @map("recipe_id") @db.Uuid
  /// numeric(9,2) CHECK > 0 (food path).
  quantityGrams  Decimal? @map("quantity_grams") @db.Decimal(9, 2)
  /// numeric(6,2) CHECK > 0 (recipe path).
  recipeServings Decimal? @map("recipe_servings") @db.Decimal(6, 2)
  // Snapshot nutrients; NUMERIC CHECK >= 0 (in SQL).
  caloriesKcal   Decimal  @map("calories_kcal") @db.Decimal(10, 2)
  proteinG       Decimal  @map("protein_g") @db.Decimal(9, 3)
  carbohydrateG  Decimal  @map("carbohydrate_g") @db.Decimal(9, 3)
  fatG           Decimal  @map("fat_g") @db.Decimal(9, 3)
  fiberG         Decimal? @map("fiber_g") @db.Decimal(9, 3)
  /// CHECK in ('measured','label_declared','estimated','unknown').
  confidence     String   @db.Text
  notes          String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  food   Food?   @relation(fields: [foodId], references: [id], onDelete: Restrict)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: Restrict)

  // Polymorphic ref: two nullable FKs + mutually-exclusive CHECK (in SQL).
  @@index([mealId])
  @@index([foodId])
  @@index([recipeId])
  @@map("meal_items")
}

/// Per-user-day aggregate snapshot + targets actually applied that day.
/// Invariant: fully recomputable from meal_items; the stored copy exists so
/// dashboards/audits do not depend on recompute-at-read.
model DailyNutrition {
  id                 String   @id @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  /// User-local day (users.timezone).
  localDate          DateTime @map("local_date") @db.Date
  // Snapshot totals; NUMERIC CHECK >= 0 (in SQL).
  totalCaloriesKcal  Decimal  @map("total_calories_kcal") @db.Decimal(10, 2)
  totalProteinG      Decimal  @map("total_protein_g") @db.Decimal(9, 3)
  totalCarbohydrateG Decimal  @map("total_carbohydrate_g") @db.Decimal(9, 3)
  totalFatG          Decimal  @map("total_fat_g") @db.Decimal(9, 3)
  totalFiberG        Decimal? @map("total_fiber_g") @db.Decimal(9, 3)
  /// Frozen copy of domain NutritionTargets incl. basis_note (§5 S3).
  targetsSnapshot    Json?    @map("targets_snapshot") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, localDate])
  @@index([userId, localDate(sort: Desc)])
  @@map("daily_nutrition")
}

// ---------------------------------------------------------------------------
// Cluster E — coaching loop (§4.9, §11, §12)
// ---------------------------------------------------------------------------

/// A deterministic problem statement grounded in evidence. Linked to the goal
/// and plan version that were active when it was created, so later goal/plan
/// changes never rewrite old context.
model Diagnosis {
  id                  String    @id @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  activeGoalId        String?   @map("active_goal_id") @db.Uuid
  activePlanVersionId String?   @map("active_plan_version_id") @db.Uuid
  /// Stable machine code, e.g. 'protein_intake_below_target'.
  code                String    @db.Text
  title               String    @db.Text
  summary             String    @db.Text
  /// CHECK in ('informational','watch','act','urgent').
  severity            String    @db.Text
  /// CHECK in ('open','monitoring','resolved','dismissed').
  status              String    @db.Text
  analysisWindowDays  Int?      @map("analysis_window_days")
  /// Frozen inputs used at analysis time (§5 S3) — justified JSON.
  contextSnapshot     Json?     @map("context_snapshot") @db.JsonB
  /// Domain fields: factors/alternatives ruled in and out (divergence D9).
  contributingFactors String[]  @default([]) @map("contributing_factors")
  ruledOut            String[]  @default([]) @map("ruled_out")
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeGoal        Goal?                 @relation("DiagnosisActiveGoal", fields: [activeGoalId], references: [id], onDelete: Restrict)
  activePlanVersion TrainingPlanVersion?  @relation("DiagnosisActivePlanVersion", fields: [activePlanVersionId], references: [id], onDelete: Restrict)
  evidence          DiagnosisEvidence[]
  recommendations   Recommendation[]
  interventions     Intervention[]
  followUpOutcomes  InterventionOutcome[] @relation("OutcomeFollowUpDiagnosis")

  // partial (user_id) WHERE status IN ('open','monitoring') — in SQL.
  @@index([userId, createdAt(sort: Desc)])
  @@index([code])
  @@index([activeGoalId])
  @@index([activePlanVersionId])
  @@map("diagnoses")
}

/// The deterministic findings behind a diagnosis. Immutable child rows.
model DiagnosisEvidence {
  id              String   @id @db.Uuid
  diagnosisId     String   @map("diagnosis_id") @db.Uuid
  /// Metric identifier, e.g. 'protein_daily_avg_g'.
  metric          String   @db.Text
  /// Analysis window, e.g. 'last_14_days'.
  window          String   @db.Text
  observed        String   @db.Text
  /// Queryable numeric companion when the observation is a number.
  observedNumeric Decimal? @map("observed_numeric") @db.Decimal(14, 4)
  expected        String?  @db.Text
  position        Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@index([metric])
  @@map("diagnosis_evidence")
}

/// What the system told the user, when, and why.
model Recommendation {
  id                     String    @id @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  diagnosisId            String?   @map("diagnosis_id") @db.Uuid
  interventionId         String?   @map("intervention_id") @db.Uuid
  headline               String    @db.Text
  explanation            String    @db.Text
  alternativesConsidered String[]  @default([]) @map("alternatives_considered")
  presentedAt            DateTime  @default(now()) @map("presented_at") @db.Timestamptz(6)
  /// CHECK in ('presented','acknowledged','acted_on','dismissed','expired').
  status                 String    @db.Text
  acknowledgedAt         DateTime? @map("acknowledged_at") @db.Timestamptz(6)
  dismissedAt            DateTime? @map("dismissed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis    Diagnosis?               @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)
  intervention Intervention?            @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  evidence     RecommendationEvidence[]

  @@index([userId, presentedAt(sort: Desc)])
  @@index([diagnosisId])
  @@index([interventionId])
  @@map("recommendations")
}

/// Evidence as presented to the user — intentionally a copy, so later edits
/// to diagnosis evidence never rewrite what the user saw.
model RecommendationEvidence {
  id               String   @id @db.Uuid
  recommendationId String   @map("recommendation_id") @db.Uuid
  metric           String   @db.Text
  window           String   @db.Text
  observed         String   @db.Text
  observedNumeric  Decimal? @map("observed_numeric") @db.Decimal(14, 4)
  expected         String?  @db.Text
  position         Int

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)

  @@index([recommendationId])
  @@map("recommendation_evidence")
}

/// The action taken (or deliberately: no action) to address a diagnosis.
/// 'no_change' is first-class (§12).
model Intervention {
  id                         String    @id @db.Uuid
  userId                     String    @map("user_id") @db.Uuid
  diagnosisId                String?   @map("diagnosis_id") @db.Uuid
  supersededByInterventionId String?   @map("superseded_by_intervention_id") @db.Uuid
  activeGoalId               String?   @map("active_goal_id") @db.Uuid
  activePlanVersionId        String?   @map("active_plan_version_id") @db.Uuid
  /// CHECK in domain InterventionKind values (includes 'no_change').
  kind                       String    @db.Text
  /// Kind-specific structured params; shape validated per-kind in the
  /// application, never by the DB (§12). Justified JSON.
  parameters                 Json      @default("{}") @db.JsonB
  rationale                  String    @db.Text
  expectedEffect             String    @map("expected_effect") @db.Text
  reviewOn                   DateTime? @map("review_on") @db.Date
  /// CHECK in ('proposed','accepted','active','completed','rejected','superseded').
  status                     String    @db.Text
  acceptedAt                 DateTime? @map("accepted_at") @db.Timestamptz(6)
  completedAt                DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosis         Diagnosis?            @relation(fields: [diagnosisId], references: [id], onDelete: Restrict)
  supersededBy      Intervention?         @relation("InterventionSupersession", fields: [supersededByInterventionId], references: [id], onDelete: SetNull)
  supersessions     Intervention[]        @relation("InterventionSupersession")
  activeGoal        Goal?                 @relation("InterventionActiveGoal", fields: [activeGoalId], references: [id], onDelete: Restrict)
  activePlanVersion TrainingPlanVersion?  @relation("InterventionActivePlanVersion", fields: [activePlanVersionId], references: [id], onDelete: Restrict)
  outcomes          InterventionOutcome[]
  recommendations   Recommendation[]

  // partial (user_id) WHERE status = 'active' — in SQL.
  @@index([userId, createdAt(sort: Desc)])
  @@index([diagnosisId])
  @@index([activeGoalId])
  @@index([activePlanVersionId])
  @@map("interventions")
}

/// The observed result after the review window; closes the adaptive loop.
/// Immutable; re-evaluation adds a new row (UNIQUE per evaluation window).
model InterventionOutcome {
  id                  String   @id @db.Uuid
  interventionId      String   @map("intervention_id") @db.Uuid
  followUpDiagnosisId String?  @map("follow_up_diagnosis_id") @db.Uuid
  evaluatedAt         DateTime @map("evaluated_at") @db.Timestamptz(6)
  /// e.g. '14d_post'.
  evaluationWindow    String   @map("evaluation_window") @db.Text
  /// CHECK in ('improved_as_expected','no_effect','worsened','uncertain','too_early').
  verdict             String   @db.Text
  observations        String[] @default([])
  explanation         String   @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  intervention      Intervention @relation(fields: [interventionId], references: [id], onDelete: Restrict)
  followUpDiagnosis Diagnosis?   @relation("OutcomeFollowUpDiagnosis", fields: [followUpDiagnosisId], references: [id], onDelete: SetNull)

  @@unique([interventionId, evaluationWindow])
  @@index([interventionId])
  @@index([followUpDiagnosisId])
  @@map("intervention_outcomes")
}

/// ---------------------------------------------------------------------------
// Cluster E (cont.) — Unified Decision Brain (§4.9, §11, §12, Phase 8)
/// Immutable decision snapshots, evidence, assumptions, and outcomes.
/// ---------------------------------------------------------------------------

/// A complete unified decision record. Immutable; supersession chain
/// preserves full reasoning history. Generated by the unified decision engine.
model DecisionSnapshot {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// User-local calendar day the decision was made.
  decidedAt          DateTime  @map("decided_at") @db.Date
  /// Kind of decision: 'no_change' | 'intervention_selected' | 'plan_adaptation' | 'measurement_protocol_change'.
  kind               String    @db.Text
  /// Status: 'current' | 'superseded' | 'archived'.
  status             String    @db.Text
  /// The unified state this decision was based on.
  unifiedStateId     String    @map("unified_state_id") @db.Uuid
  /// Diagnoses this decision addresses.
  diagnosesAddressed String[]  @map("diagnoses_addressed") @default([]) @db.Text
  /// The selected interventions.
  interventions      DecisionIntervention[]
  /// Explicit assumptions underlying this decision.
  assumptions        DecisionAssumption[]
  /// Evidence citations supporting this decision.
  evidence           DecisionEvidence[]
  /// Monitoring plan for follow-up.
  monitoringPlan     String[]  @map("monitoring_plan") @default([]) @db.Text
  /// Configuration version used (e.g., "fitcoach.unified_decision.v1").
  configVersion      String    @map("config_version") @db.Text
  /// Human-readable summary for UI.
  summary            String    @db.Text
  /// Overall confidence: 'measured' | 'label_declared' | 'estimated' | 'unknown'.
  confidence         String    @db.Text
  /// Previous decision this one supersedes.
  supersedesId       String?   @map("supersedes_id") @db.Uuid
  /// Warnings about reliability.
  warnings           String[]  @default([]) @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  supersedes     DecisionSnapshot?  @relation("DecisionSupersession", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersessions  DecisionSnapshot[] @relation("DecisionSupersession")
  outcomes       DecisionOutcome[]

  @@index([userId, decidedAt(sort: Desc)])
  @@index([status])
  @@index([unifiedStateId])
  @@map("decision_snapshots")
}

/// One intervention within a decision snapshot. Immutable child row.
model DecisionIntervention {
  id                    String   @id @db.Uuid
  decisionSnapshotId    String   @map("decision_snapshot_id") @db.Uuid
  /// Kind: 'nutrition_target_adjustment' | 'training_volume_adjustment' | 'exercise_substitution' | 'split_structure_adjustment' | 'progression_scheme_adjustment' | 'recovery_adjustment' | 'activity_target_adjustment' | 'measurement_protocol_adjustment' | 'food_choice_guidance' | 'no_change'.
  kind                  String   @db.Text
  /// Kind-specific parameters (JSON).
  parameters            Json     @default("{}") @db.JsonB
  rationale             String   @db.Text
  expectedEffect        String   @map("expected_effect") @db.Text
  /// Diagnosis IDs this intervention addresses.
  addressesDiagnoses    String[] @map("addresses_diagnoses") @default([]) @db.Text
  /// When to review this intervention (user-local date).
  reviewOn              DateTime? @map("review_on") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decisionSnapshot DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id], onDelete: Cascade)

  @@index([decisionSnapshotId])
  @@map("decision_interventions")
}

/// Evidence citation in a decision snapshot. Immutable child row.
model DecisionEvidence {
  id                 String    @id @db.Uuid
  decisionSnapshotId String    @map("decision_snapshot_id") @db.Uuid
  /// Engine that produced this evidence: 'training_state' | 'nutrition_state' | 'body_state' | 'recovery_state' | 'activity_state' | 'projection_state' | 'goal_state'.
  sourceEngine       String    @map("source_engine") @db.Text
  /// Machine code identifying the finding, e.g. 'protein_intake_below_target'.
  code               String    @db.Text
  /// Human-readable title.
  title              String    @db.Text
  /// Metric identifier, e.g. 'protein_daily_avg_g'.
  metric             String    @db.Text
  /// Analysis window, e.g. 'last_14_days'.
  analysisWindow     String    @map("window") @db.Text
  /// Observed value (string form).
  observed           String    @db.Text
  /// Queryable numeric companion when the observation is a number.
  observedNumeric    Decimal?  @map("observed_numeric") @db.Decimal(14, 4)
  /// Expected/target value (string form).
  expected           String?   @db.Text
  /// Confidence: 'measured' | 'label_declared' | 'estimated' | 'unknown'.
  confidence         String    @db.Text
  /// Provenance class: 'direct_measurement' | 'label_declared' | 'derived_calculation' | 'heuristic_estimate' | 'user_reported' | 'third_party_import'.
  provenanceClass    String    @map("provenance_class") @db.Text
  /// Severity of the finding: 'informational' | 'watch' | 'act' | 'urgent'.
  severity           String    @db.Text
  /// Whether this evidence is sensitive (e.g., projection assumptions).
  sensitive          Boolean   @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decisionSnapshot DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id], onDelete: Cascade)

  @@index([decisionSnapshotId])
  @@index([sourceEngine, code])
  @@map("decision_evidence")
}

/// Explicit assumption in a decision snapshot. Immutable child row.
model DecisionAssumption {
  id                 String    @id @db.Uuid
  decisionSnapshotId String    @map("decision_snapshot_id") @db.Uuid
  /// Machine code, e.g. 'training_adherence_85_percent' | 'projection_standard_progression'.
  code               String    @db.Text
  /// Human-readable description.
  description        String    @db.Text
  /// Category: 'adherence' | 'progression_rate' | 'recovery' | 'measurement_consistency'.
  category           String    @db.Text
  /// Value as string (JSON-serializable).
  value              String    @db.Text
  /// Whether this assumption is sensitive (projection assumptions are sensitive).
  sensitive          Boolean   @default(false)
  /// Source: 'configuration' | 'projection' | 'user_declared'.
  source             String    @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decisionSnapshot DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id], onDelete: Cascade)

  @@index([decisionSnapshotId])
  @@index([category])
  @@map("decision_assumptions")
}

/// Outcome evaluation of a decision snapshot. Immutable; re-evaluation adds a new row.
model DecisionOutcome {
  id                  String    @id @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  decisionSnapshotId  String    @map("decision_snapshot_id") @db.Uuid
  /// When the outcome was evaluated.
  evaluatedAt         DateTime  @map("evaluated_at") @db.Timestamptz(6)
  /// Evaluation window, e.g. '14d_post' | '28d_post'.
  evaluationWindow    String    @map("evaluation_window") @db.Text
  /// Overall verdict: 'improved_as_expected' | 'partially_improved' | 'no_effect' | 'worsened' | 'uncertain' | 'too_early'.
  verdict             String    @db.Text
  /// Per-intervention verdicts (JSON array).
  interventionVerdicts Json     @map("intervention_verdicts") @db.JsonB
  /// Observations from evaluation.
  observations        String[]  @default([]) @db.Text
  /// Explanation of the overall verdict.
  explanation         String    @db.Text
  /// Follow-up diagnosis IDs triggered by this outcome.
  followUpDiagnosisIds String[] @map("follow_up_diagnosis_ids") @default([]) @db.Text
  /// Whether this outcome triggers re-evaluation.
  triggersReevaluation Boolean   @map("triggers_reevaluation") @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  decisionSnapshot DecisionSnapshot @relation(fields: [decisionSnapshotId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([decisionSnapshotId, evaluationWindow])
  @@index([decisionSnapshotId])
  @@index([userId])
  @@map("decision_outcomes")
}

/// ---------------------------------------------------------------------------
// Cluster F — activity & recovery (§4.10, §4.11)
// ---------------------------------------------------------------------------

/// Sleep observation from a platform health framework or manual entry.
/// Append-only: corrections add new rows, never edit.
model SleepObservation {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// User-local calendar day this sleep belongs to (the "night of").
  date            DateTime @db.Date
  /// When the sleep period started (UTC).
  startedAt       DateTime @map("started_at") @db.Timestamptz(6)
  /// When the sleep period ended (UTC).
  endedAt         DateTime @map("ended_at") @db.Timestamptz(6)
  /// Total time in bed, minutes.
  timeInBedMinutes Int?    @map("time_in_bed_minutes")
  /// Total asleep time, minutes.
  asleepMinutes   Int?     @map("asleep_minutes")
  /// Sleep efficiency percentage (asleep / time_in_bed * 100).
  efficiency      Int?     @db.SmallInt
  /// Sleep latency: minutes to fall asleep.
  latencyMinutes  Int?     @map("latency_minutes")
  /// Deep sleep minutes (N3).
  deepMinutes     Int?     @map("deep_minutes")
  /// REM sleep minutes.
  remMinutes      Int?     @map("rem_minutes")
  /// Light sleep minutes (N1+N2).
  lightMinutes    Int?     @map("light_minutes")
  /// Awake minutes during sleep period.
  awakeMinutes    Int?     @map("awake_minutes")
  /// Number of awakenings.
  awakenings      Int?
  /// CHECK in ('health_connect','apple_health','wearable','manual','other').
  source          String   @db.Text
  /// Provider event id for import dedupe.
  externalId      String?  @map("external_id") @db.Text
  /// CHECK in ('measured','estimated','unknown').
  confidence      String   @db.Text
  notes           String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PARTIAL UNIQUE (user_id, date, source) WHERE external_id IS NOT NULL — in SQL.
  @@index([userId, date(sort: Desc)])
  @@index([userId, startedAt(sort: Desc)])
  @@index([externalId])
  @@map("sleep_observations")
}

/// Subjective and physiological recovery indicators recorded for a day.
/// Append-only: new readings add rows.
model RecoveryIndicator {
  id                    String   @id @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  /// User-local calendar day.
  date                  DateTime @db.Date
  /// Heart rate variability, ms (RMSSD or SDNN).
  hrvMs                 Decimal? @map("hrv_ms") @db.Decimal(6, 1)
  /// Resting heart rate, bpm.
  restingHeartRateBpm   Int?     @map("resting_heart_rate_bpm") @db.SmallInt
  /// Platform sleep score (0-100).
  sleepScore            Int?     @map("sleep_score") @db.SmallInt
  /// Platform readiness/recovery score (0-100).
  readinessScore        Int?     @map("readiness_score") @db.SmallInt
  /// Subjective muscle soreness (1-10).
  muscleSoreness        Int?     @map("muscle_soreness") @db.SmallInt
  /// Subjective fatigue (1-10).
  fatigue               Int?     @db.SmallInt
  /// Subjective sleep quality (1-10).
  sleepQuality          Int?     @map("sleep_quality") @db.SmallInt
  /// Subjective readiness to train (1-10).
  readinessSubjective   Int?     @map("readiness_subjective") @db.SmallInt
  /// CHECK in ('health_connect','apple_health','wearable','manual','other').
  source                String   @db.Text
  /// Provider event id for import dedupe.
  externalId            String?  @map("external_id") @db.Text
  /// CHECK in ('measured','estimated','unknown').
  confidence            String   @db.Text
  notes                 String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // PARTIAL UNIQUE (user_id, date, source) WHERE external_id IS NOT NULL — in SQL.
  @@index([userId, date(sort: Desc)])
  @@index([externalId])
  @@map("recovery_indicators")
}

/// Computed daily recovery state (materialized view via service, not a table).
/// Kept here for documentation of the shape; not a Prisma model.

/// =============================================================================
/// Phase 7 — Projection & Trajectory Engine
/// =============================================================================

/// Immutable projection snapshot. Recalculation produces a new snapshot
/// (supersession chain) rather than mutating the old one.
model ProjectionSnapshot {
  id              String   @id @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// User-local calendar day the projection was generated.
  generatedAt     DateTime @map("generated_at") @db.Date
  /// Status: 'current' | 'superseded' | 'diverged'.
  status          String   @db.Text
  /// Full inputs digest for reproducibility and staleness detection (JSON).
  inputsJson      String   @map("inputs_json") @db.Text
  /// Assumptions underlying this projection (JSON array).
  assumptionsJson String   @map("assumptions_json") @db.Text
  /// Projected metrics with ranges and confidence (JSON array).
  metricsJson     String   @map("metrics_json") @db.Text
  /// Optional: which snapshot this supersedes.
  supersedesId    String?  @map("supersedes_id") @db.Uuid
  /// Configuration version used (e.g., "fitcoach.projection.v1").
  configVersion   String   @map("config_version") @db.Text
  /// Human-readable summary for UI.
  summary         String   @db.Text
  /// Warnings about reliability (JSON array).
  warningsJson    String   @map("warnings_json") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  divergences ProjectionDivergence[]

  @@index([userId, generatedAt(sort: Desc)])
  @@index([status])
  @@map("projection_snapshots")
}

/// Records when actual outcomes diverge from a projection.
/// Used as input to diagnosis (Phase 8).
model ProjectionDivergence {
  id                   String   @id @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  /// The projection that was diverged from.
  projectionSnapshotId String   @map("projection_snapshot_id") @db.Uuid
  /// The metric that diverged: 'body_weight_kg' | 'body_fat_percent' | 'muscle_mass_kg' | 'measurement_cm' | 'strength_1rm_kg' | 'volume_weekly_sets' | 'protein_daily_g' | 'calories_daily_kcal'.
  target               String   @db.Text
  /// Horizon that was projected: 'current' | '1_month' | '3_months' | '6_months' | '12_months' | 'custom'.
  horizon              String   @db.Text
  /// Date the divergence was detected.
  detectedAt           DateTime @map("detected_at") @db.Date
  /// Projected central value at that horizon.
  projectedCentral     Decimal  @map("projected_central") @db.Decimal(10, 3)
  /// Actual observed value at that horizon.
  actualValue          Decimal  @map("actual_value") @db.Decimal(10, 3)
  /// Absolute difference.
  absoluteDifference   Decimal  @map("absolute_difference") @db.Decimal(10, 3)
  /// Relative difference as percentage.
  relativeDifferencePercent Decimal @map("relative_difference_percent") @db.Decimal(6, 2)
  /// Whether this divergence is significant enough to trigger diagnosis.
  significant          Boolean
  /// Context for why this might have happened.
  context              String?  @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectionSnapshot ProjectionSnapshot @relation(fields: [projectionSnapshotId], references: [id], onDelete: Cascade)

  @@index([projectionSnapshotId])
  @@index([userId, detectedAt(sort: Desc)])
  @@index([target, horizon])
  @@map("projection_divergences")
}

/// Phase 9 — AI Coach conversation persistence.
///
/// Conversations are user-owned transcripts of coaching turns. Messages record
/// both the raw turn content and the structured evidence/context used to
/// produce the assistant response. Conversations are ephemeral summaries of
/// interaction — they never replace durable user facts (profile, goals,
/// measurements, etc.), which live in their own tables.
model Conversation {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.Text
  /// CHECK in ('active','archived').
  status    String   @db.Text
  messages  ConversationMessage[]

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
}

/// One turn within a conversation. Role distinguishes user vs assistant vs
/// system. Structured fields (contextSnapshot, evidenceRefs, proposedActions)
/// store the deterministic evidence behind assistant responses so every answer
/// is auditable against persisted data.
model ConversationMessage {
  id              String   @id @db.Uuid
  conversationId  String   @map("conversation_id") @db.Uuid
  /// CHECK in ('user','assistant','system').
  role            String   @db.Text
  content         String   @db.Text
  /// Structured context snapshot used for this turn (JSON).
  contextSnapshot Json?    @map("context_snapshot") @db.JsonB
  /// Evidence references cited in the response (JSON array).
  evidenceRefs    Json?    @map("evidence_refs") @db.JsonB
  /// Proposed actions from this turn (JSON array).
  proposedActions Json?    @map("proposed_actions") @db.JsonB
  /// Whether this assistant message was produced by a mock provider.
  isMock          Boolean  @default(false) @map("is_mock")
  /// Provider identity (e.g. 'mock', 'anthropic', 'openai').
  provider        String?  @db.Text
  /// Provider model identifier.
  model           String?  @db.Text

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([conversationId, createdAt(sort: Asc)])
  @@map("conversation_messages")
}